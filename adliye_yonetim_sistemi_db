CREATE FUNCTION public.fn_log_case_status_change() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    IF NEW.status IS DISTINCT FROM OLD.status THEN
        INSERT INTO case_logs(case_id, action, old_status, new_status)
        VALUES (NEW.case_id, 'STATUS_CHANGE', OLD.status, NEW.status);
    END IF;

    RETURN NEW;
END;
$$;


