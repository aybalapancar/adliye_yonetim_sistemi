CREATE FUNCTION public.fn_close_case_on_decision_document() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
    current_status VARCHAR(20);
BEGIN
    -- Davanın mevcut durumunu al
    SELECT status
    INTO current_status
    FROM cases
    WHERE case_id = NEW.case_id;

    -- Eğer dava zaten kapalıysa bir şey yapma
    IF current_status = 'kapalı' THEN
        RETURN NEW;
    END IF;

    -- Karar / sonuç evrağı kontrolü
    IF lower(NEW.doc_name) LIKE '%karar%'
       OR lower(NEW.doc_name) LIKE '%sonuç%' THEN

        UPDATE cases
        SET status = 'kapalı'
        WHERE case_id = NEW.case_id;

    END IF;

    RETURN NEW;
END;
$$;


